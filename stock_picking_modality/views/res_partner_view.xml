<?xml version="1.0"?>
<odoo>
    <record id="res_partner_view_publiponce" model="ir.ui.view">
        <field name="name">res.partner.view.publiponce</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='vat']" position="after">
                <field name="is_resource"/>
                <field name="color" widget="color_picker"/>
                <field name="color2" widget="color"/>
            </xpath>
        </field>
    </record>
</odoo>

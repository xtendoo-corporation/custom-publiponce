<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_sale_order_line_planning_tree" model="ir.ui.view">
        <field name="name">Sale order line planning tree</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <tree string="Sale order line Planning">
                <field name="product_template_id"/>
                <field name="route_id"/>
                <field name="modality_id"/>
                <field name="destiny_id"/>
                <field name="zone_id"/>
                <field name="partner_id"/>
                <field name="date_scheduled"/>
                <field name="state_planning"/>
                <field name="product_uom_qty"/>
                <field name="price" string="Coste"/>
                <field name="price_subtotal"/>
            </tree>
        </field>
    </record>

    <record id="view_sale_order_line_planning_form" model="ir.ui.view">
        <field name="name">Sale order line planning form</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <form string="Sale order line Planning">
                <header>
                    <button name="action_receive_products" type="object" string="Recepcionar" class="btn-primary"
                            attrs="{'invisible': [('state_planning', '!=', 'waiting_reception')]}"/>
                    <button name="action_move_to_truck" type="object" string="Mover a furgón" class="btn-primary"
                            attrs="{'invisible': [('state_planning', '!=', 'in_stock')]}"/>
                    <button name="action_deliver_products" type="object" string="Entregar al cliente"
                            class="btn-primary"
                            attrs="{'invisible': [('state_planning', '!=', 'in_van')]}"/>
                    <button name="action_partial_delivery" type="object" string="Entrega Parcial"
                            class="btn-primary"
                            attrs="{'invisible': [('state_planning', '!=', 'in_van')]}"/>
<!--                    <button name="show_related_stock_move_lines" type="object" string="Mostrar Stock Move Lines"-->
<!--                            class="btn-secondary"/>-->
                    <field name="state_planning" widget="statusbar"
                           statusbar_visible="waiting_reception,in_stock_partially,in_stock,in_van,delivered"
                           modifiers="{'readonly': true}"/>
                </header>
                <sheet>
                    <group>
                        <field name="product_template_id" string="Producto"/>
                        <field name="route_id"/>
                        <field name="modality_id"/>
                        <field name="destiny_id"/>
                        <field name="zone_id"/>
                        <field name="date_scheduled"/>
                        <field name="state_planning"/>
                        <field name="product_uom_qty"/>
                        <field name="price" string="Coste"/>
                        <field name="price_subtotal"/>
                        <field name="tag_ids" widget="many2many_tags"
                               options="{'color_field': 'color','no_create': True}, 'no_create_edit': True}"/>

                    </group>
                </sheet>
                <!--                <div class="oe_chatter">-->
                <!--                    <field-->
                <!--                        name="message_follower_ids"-->
                <!--                        widget="mail_followers"-->
                <!--                        help="Follow this salesteam to automatically track the events associated to users of this team."-->
                <!--                    />-->
                <!--                    <field name="message_ids" widget="mail_thread"/>-->
                <!--                </div>-->
            </form>
        </field>
    </record>

    <record id="view_sale_order_line_planning_search" model="ir.ui.view">
        <field name="name">sale.order.line.planning.search</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <search string="Sale order line Planning">
                <field name="product_template_id"/>
                <field name="route_id"/>
                <field name="modality_id"/>
                <field name="destiny_id"/>
                <field name="zone_id"/>
                <field name="partner_id"/>
                <field name="date_scheduled"/>
                <field name="state_planning"/>
                <field name="product_uom_qty"/>
                <field name="price" string="Coste"/>
                <field name="price_subtotal"/>
                <filter string="Fecha planificada" name="group_by_date_scheduled"
                        context="{'group_by':'date_scheduled:day'}"/>
                <separator/>
                <filter string="Modalidad" name="group_by_modality_id" context="{'group_by':'modality_id'}"/>
                <separator/>
                <filter string="Destino" name="group_by_destiny_id" context="{'group_by':'destiny_id'}"/>
                <separator/>
                <filter string="Zona" name="group_by_zone_id" context="{'group_by':'zone_id'}"/>
                <separator/>
                <filter string="Recurso" name="group_by_route_id" context="{'group_by':'route_id'}"/>
                <separator/>
                <filter string="Not delivered" name="not_delivered_filter" domain="[('state_planning', '!=', 'delivered')]"/>
                <separator/>
                <filter string="Delivered" name="delivered_filter" domain="[('state_planning', '=', 'delivered')]"/>
            </search>
        </field>
    </record>

    <record id="view_sale_order_line_planning_kanban" model="ir.ui.view">
        <field name="name">Sale order line planning kanban</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="product_template_id"/>
                <field name="route_id"/>
                <field name="modality_id"/>
                <field name="destiny_id"/>
                <field name="zone_id"/>
                <field name="partner_id"/>
                <field name="date_scheduled"/>
                <field name="product_uom_qty"/>
                <field name="state_planning"/>
                <field name="color"/>
                <field name="partner_color"/>
                <field name="in_stock"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="#{kanban_color(record.partner_color.raw_value)} oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <div class="o_kanban_record_title d-flex justify-content-between">
                                    <strong>
                                        <t t-esc="record.product_template_id.value"/>
                                    </strong>
                                    <t t-if="record.state_planning.raw_value == 'delivered'">
                                        <strong
                                            t-attf-style="text-align: right;">
                                            <t t-esc="record.product_uom_qty.value"/>
                                                <span></span>
                                                <i class="fa fa-truck" title="Entregado"/>
                                        </strong>
                                    </t>
                                     <t t-if="record.state_planning.raw_value == 'in_stock'">
                                        <strong
                                            t-attf-style="text-align: right;">
                                            <t t-esc="record.product_uom_qty.value"/>
                                        </strong>
                                    </t>
                                    <t t-if="record.state_planning.raw_value == 'in_van'">
                                        <strong
                                            t-attf-style="text-align: right;">
                                            <t t-esc="record.product_uom_qty.value"/>
                                        </strong>
                                    </t>
                                    <t t-if="record.state_planning.raw_value == 'waiting_reception'">
                                        <strong
                                            t-attf-style="text-align: right; color: red">
                                            <t t-esc="record.product_uom_qty.value"/>
                                        </strong>
                                    </t>
                                    <t t-if="record.state_planning.raw_value == 'in_stock_partially'">
                                        <strong
                                            t-attf-style="text-align: right; color: orange">
                                            <t t-esc="record.product_uom_qty.value"/>
                                        </strong>
                                    </t>
                                </div>
                                <hr/>
                                <div class="oe_kanban_details row">
                                    <div class="col-12">
                                        <div>
                                            <span class="badge rounded-pill bg-dark"
                                                  style="color: white; font-size: 1.05em; margin-bottom: 2px;">
                                                <t t-esc="record.modality_id.value"/>
                                            </span>
                                            <span class="badge rounded-pill bg-light"
                                                  style="font-size: 1.05em; margin-bottom: 2px;">
                                                <t t-esc="record.destiny_id.value"/>
                                            </span>
                                            <span class="badge rounded-pill bg-light"
                                                  style="font-size: 1.05em; margin-bottom: 2px;">
                                                <t t-esc="record.zone_id.value"/>
                                            </span>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <field name="tag_ids" widget="many2many_tags"
                                               options="{'color_field': 'color'}"/>
                                    </div>
                                    <div class="col-12">
                                        <span class="badge rounded-pill bg-info"
                                              style="font-size: 1.05em; margin-bottom: 2px; color: white">
                                            <t t-esc="record.state_planning.value"/>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sale_order_line_planning_calendar" model="ir.ui.view">
        <field name="name">Sale order line planning calendar</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <calendar string="Sale order line Planning" date_start="date_scheduled" color="partner_color"
                      hide_time="true" mode="month">
                <field name="modality_id"/>
                <field name="destiny_id"/>
                <field name="zone_id"/>
                <field name="partner_id" avatar_field="avatar_128"/>
            </calendar>
        </field>
    </record>

    <record id="view_sale_order_line_pivot" model="ir.ui.view">
        <field name="name">Sale order line planning pivot</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <pivot string="Sale order line Planning Analysis">
                <field name="date_scheduled" type="row"/>
                <field name="modality_id" type="col"/>
                <field name="destiny_id"/>
                <field name="zone_id"/>
                <field name="state_planning" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="action_deliver_products" model="ir.actions.server">
        <field name="name">Deliver Products</field>
        <field name="model_id" ref="model_sale_order_line"/>
        <field name="state">code</field>
        <field name="code">action = model.action_deliver_products()</field>
    </record>

     <record id="cron_mark_as_delivered" model="ir.cron">
        <field name="name">Marcar como entregado</field>
        <field name="model_id" ref="model_sale_order_line"/>
        <field name="state">code</field>
        <field name="code">model.mark_as_delivered()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(hours=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>

    <record id="action_sale_order_line_planning" model="ir.actions.act_window">
        <field name="name">Planning</field>
        <field name="res_model">sale.order.line</field>
        <field name="view_mode">kanban,calendar,pivot,tree,form</field>
        <field name="context">{'search_default_not_delivered_filter': 1, 'search_default_group_by_date_scheduled': 1}
        </field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first planning
            </p>
            <p>
                Here you can create and manage your stock move planning.
            </p>
        </field>
    </record>

    <record id="action_res_partner_resource" model="ir.actions.act_window">
        <field name="name">Resources</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('is_resource','=',True)]</field>
    </record>

    <menuitem id="menu_sale_order_line_planning" name="Planning" parent="stock.menu_stock_root" sequence="100"/>

    <menuitem id="menu_planning" name="Planning" parent="menu_sale_order_line_planning"
              action="action_sale_order_line_planning" sequence="10"/>

    <menuitem id="menu_res_partner_resource" name="Resources" parent="menu_sale_order_line_planning"
              action="action_res_partner_resource" sequence="20"/>

</odoo>

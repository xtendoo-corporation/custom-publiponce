<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_stock_move_planning_tree" model="ir.ui.view">
        <field name="name">Stock move planning</field>
        <field name="model">stock.move.planning</field>
        <field name="arch" type="xml">
            <tree string="Stock Move Planning">
                <field name="product_name"/>
                <field name="modality_id"/>
                <field name="destiny_id"/>
                <field name="zone_id"/>
                <field name="res_partner_id"/>
                <field name="date_scheduled"/>
                <field name="delivery_date"/>
                <field name="is_delivered"/>
                <field name="quantity"/>
                <field name="price"/>
                <field name="total_price"/>
            </tree>
        </field>
    </record>

    <record id="view_stock_move_planning_form" model="ir.ui.view">
        <field name="name">Stock move planning form</field>
        <field name="model">stock.move.planning</field>
        <field name="arch" type="xml">
            <form string="Stock Move Planning">
                <sheet>
                    <group>
                        <field name="product_name"/>
                        <field name="modality_id"/>
                        <field name="destiny_id"/>
                        <field name="zone_id"/>
                        <field name="res_partner_id"/>
                        <field name="date_scheduled"/>
                        <field name="date_scheduled_time"/>
                        <field name="delivery_date"/>
                        <field name="is_delivered"/>
                        <field name="quantity"/>
                        <field name="price"/>
                        <field name="total_price"/>
                        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color','no_create': True}, 'no_create_edit': True}"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field
                        name="message_follower_ids"
                        widget="mail_followers"
                        help="Follow this salesteam to automatically track the events associated to users of this team."
                    />
                    <field name="message_ids" widget="mail_thread" />
                </div>
            </form>
        </field>
    </record>

    <record id="view_stock_move_planning_search" model="ir.ui.view">
        <field name="name">stock.move.planning.search</field>
        <field name="model">stock.move.planning</field>
        <field name="arch" type="xml">
            <search string="Stock Move Planning">
                <field name="product_name"/>
                <field name="modality_id"/>
                <field name="destiny_id"/>
                <field name="zone_id"/>
                <field name="res_partner_id"/>
                <field name="partner_id"/>
                <field name="date_scheduled"/>
                <field name="delivery_date"/>
                <field name="is_delivered"/>
                <field name="quantity"/>
                <field name="price"/>
                <field name="total_price"/>
                <filter string="Fecha planificada" name="group_by_date_scheduled"
                        context="{'group_by':'date_scheduled:day'}"/>
                <separator/>
                <filter string="Modalidad" name="group_by_modality_id" context="{'group_by':'modality_id'}"/>
                <separator/>
                <filter string="Destino" name="group_by_destiny_id" context="{'group_by':'destiny_id'}"/>
                <separator/>
                <filter string="Zona" name="group_by_zone_id" context="{'group_by':'zone_id'}"/>
                <separator/>
                <filter string="Recurso" name="group_by_res_partner_id" context="{'group_by':'res_partner_id'}"/>
                <separator/>
                <filter string="No entregado" name="no_entregado_filter" domain="[('is_delivered', '=', False)]"/>
                <separator/>
                <filter string="Resource" name="resource_filter" domain="[('res_partner_id', '!=', False)]"/>
                <separator/>
                <filter string="Delivered" name="entregado_filter" domain="[('is_delivered', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="view_stock_move_planning_kanban" model="ir.ui.view">
        <field name="name">stock.move.planning.kanban</field>
        <field name="model">stock.move.planning</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="product_name"/>
                <field name="modality_id"/>
                <field name="destiny_id"/>
                <field name="zone_id"/>
                <field name="res_partner_id"/>
                <field name="partner_id"/>
                <field name="date_scheduled"/>
                <field name="quantity"/>
                <field name="delivery_date"/>
                <field name="is_delivered"/>
                <field name="color"/>
                <field name="partner_color"/>
                <field name="is_stock_sufficient"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="#{kanban_color(record.partner_color.raw_value)} oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <div class="o_kanban_record_title d-flex justify-content-between">
                                    <strong>
                                        <t t-esc="record.product_name.value"/>
                                    </strong>
                                    <strong
                                        t-attf-style="text-align: right; color: #{record.is_stock_sufficient ? 'black' : 'red'};">
                                        <t t-esc="record.quantity.value"/>
                                        <t t-if="record.is_delivered.raw_value">
                                            <span> </span>
                                            <i class="fa fa-truck"/>
                                        </t>
                                    </strong>
                                </div>
                                <hr/>
                                <div class="oe_kanban_details row">
                                    <div class="col-12">
                                        <div>
                                            <span class="badge rounded-pill bg-dark"
                                                  style="color: white; font-size: 1.05em; margin-bottom: 2px;">
                                                <t t-esc="record.modality_id.value"/>
                                            </span>
                                            <span class="badge rounded-pill bg-light"
                                                  style="font-size: 1.05em; margin-bottom: 2px;">
                                                <t t-esc="record.destiny_id.value"/>
                                            </span>
                                            <span class="badge rounded-pill bg-light"
                                                  style="font-size: 1.05em; margin-bottom: 2px;">
                                                <t t-esc="record.zone_id.value"/>
                                            </span>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div>
                                            <span class="badge rounded-pill bg-info"
                                                  style="color: white; font-size: 1.05em; margin-bottom: 2px;">
                                                <t t-esc="record.res_partner_id.value"/>
                                            </span>
                                        </div>
                                    </div>
                                    <div class="col-12">
<!--                                        <span class="badge rounded-pill bg-success"-->
<!--                                              style="color: white; font-size: 1.05em;">-->
                                        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
<!--                                            <t t-esc="record.partner_id.value"/>-->
<!--                                        </span>-->
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_stock_move_planning_calendar" model="ir.ui.view">
        <field name="name">stock.move.planning.calendar</field>
        <field name="model">stock.move.planning</field>
        <field name="arch" type="xml">
            <calendar string="Stock Move Planning" date_start="date_scheduled_time" color="partner_color" hide_time="true">
                <field name="modality_id"/>
                <field name="destiny_id"/>
                <field name="zone_id"/>
                <field name="partner_id" avatar_field="avatar_128"/>
                <field name="res_partner_id" avatar_field="avatar_128" />
            </calendar>
        </field>
    </record>

    <record id="view_stock_move_planning_pivot" model="ir.ui.view">
        <field name="name">stock.move.planning.pivot</field>
        <field name="model">stock.move.planning</field>
        <field name="arch" type="xml">
            <pivot string="Stock Move Planning Analysis">
                <field name="date_scheduled" type="row"/>
                <field name="modality_id" type="col"/>
                <field name="destiny_id"/>
                <field name="zone_id"/>
                <field name="quantity" type="measure"/>
                <field name="is_delivered" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="cron_mark_as_delivered" model="ir.cron">
        <field name="name">Marcar como entregado</field>
        <field name="model_id" ref="model_stock_move_planning"/>
        <field name="state">code</field>
        <field name="code">model.mark_as_delivered()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(hours=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>

    <record id="action_stock_move_planning" model="ir.actions.act_window">
        <field name="name">Planning</field>
        <field name="res_model">stock.move.planning</field>
        <field name="view_mode">kanban,calendar,pivot,tree,form</field>
        <field name="context">{'search_default_no_entregado_filter': 1, 'search_default_group_by_date_scheduled': 1}
        </field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first planning
            </p>
            <p>
                Here you can create and manage your stock move planning.
            </p>
        </field>
    </record>

    <record id="action_res_partner_resource" model="ir.actions.act_window">
        <field name="name">Resources</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('is_resource','=',True)]</field>
    </record>

    <menuitem id="menu_stock_move_planning" name="Planning" parent="stock.menu_stock_root" sequence="100"/>

    <menuitem id="menu_planning" name="Planning" parent="menu_stock_move_planning"
              action="action_stock_move_planning" sequence="10"/>

    <menuitem id="menu_res_partner_resource" name="Resources" parent="menu_stock_move_planning"
              action="action_res_partner_resource" sequence="20"/>

</odoo>

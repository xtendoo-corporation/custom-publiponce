<odoo>
    <data>
        <record id="action_stock_picking_zone" model="ir.actions.act_window">
            <field name="name">Zona de entregas</field>
            <field name="res_model">stock.picking.zone</field>
            <field name="view_mode">tree,form</field>
        </record>

        <record id="view_stock_picking_zone_tree" model="ir.ui.view">
            <field name="name">stock.picking.zone.tree</field>
            <field name="model">stock.picking.zone</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                </tree>
            </field>
        </record>

        <record id="view_stock_picking_zone_form" model="ir.ui.view">
            <field name="name">stock.picking.zone.form</field>
            <field name="model">stock.picking.zone</field>
            <field name="arch" type="xml">
                <form editable="top">
                    <group colspan="4">
                        <field name="name"/>
                    </group>
                </form>
            </field>
        </record>
    </data>
</odoo>

<odoo>
    <record id="view_order_form_publiponce" model="ir.ui.view">
        <field name="name">Sale order form Planning</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="object" name="action_view_plannings" class="oe_stat_button" icon="fa-calendar"
                        modifiers="{&quot;invisible&quot;: [[&quot;delivery_count&quot;, &quot;=&quot;, 0]]}">
                    <span>Plannings</span>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
